---
import Base from '../layouts/Base.astro';

// TODO: all placeholder. Replace companies, dates and links with real ones.
const history = [
  ['2024 — now', 'Principal SRE', 'Global payments processor', 'Own reliability for a platform moving billions a day. Built the SLO program and the incident command rotation from scratch.'],
  ['2020 — 2024', 'Staff Platform Engineer', 'Hyperscale cloud provider', 'Ran multi-region Kubernetes for internal teams. Led two control-plane migrations with zero customer downtime.'],
  ['2018 — 2020', 'Senior DevOps Engineer', 'Series B logistics startup', 'Took a monolith on one VM to a fleet on Terraform and GitOps. Learned what not to do with state files.'],
  ['2016 — 2018', 'Systems Engineer', 'Managed hosting provider', 'Linux, networking and a pager. The fundamentals every other year was built on.'],
];
const links = [['LinkedIn', '#'], ['GitHub', '#'], ['YouTube', '#'], ['Email', '#']];
---
<Base title="About" description="Ten years of SRE, distilled into courses and a weekly letter.">
  <canvas id="hero-canvas" data-follow aria-hidden="true"></canvas>
  <section class="page-hero pt-44 pb-16">
    <div class="page-hero__glow" data-glow aria-hidden="true"></div>
    <div class="wrap grid lg:grid-cols-[1.3fr_1fr] gap-12 items-end">
      <div>
        <p class="eyebrow" data-hero>About</p>
        <h1 class="display h1 mt-6" data-split>Ten years of <em>3 a.m.</em></h1>
        <p class="lead mt-8" data-hero>
          I am Mahesh Kokare. I have spent a decade as a Site Reliability Engineer keeping payments systems, cloud platforms and fast-growing startups online. OpsCortex is everything I wish someone had taught me before the first page.
        </p>
      </div>
      <div class="card" data-hero>
        <div class="card__in portrait">
          <span class="display portrait__mark" aria-hidden="true">MK</span>
          <div class="mt-auto"><p class="font-semibold text-lg">Mahesh Kokare</p><p class="text-[var(--muted)]">SRE · Instructor · Writer</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap grid grid-cols-2 md:grid-cols-4 gap-8 py-8 border-y border-[var(--line)]">
      {[['10', '', 'years on-call'], ['300', '+', 'incidents commanded'], ['40', '+', 'rotations designed'], ['4', '', 'companies, four industries']].map(([n, s, l], i) => (
        <div data-reveal data-delay={String(i * 0.08)}>
          <div class="display" style="font-size:clamp(2.5rem,5vw,4.5rem);line-height:1" data-count={n} data-suffix={s}>0</div>
          <p class="mono mt-2">{l}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap grid lg:grid-cols-[1fr_1.5fr] gap-12">
      <div data-parallax="16">
        <p class="eyebrow" data-reveal>How I teach</p>
        <h2 class="display h2 mt-5" data-split>Break it. <em>Then</em> explain it.</h2>
      </div>
      <div class="prose" data-reveal>
        <p>Every course I have taken started with theory and ended, if you were lucky, with a demo. Mine run backwards. You get a working system, something breaks, and we figure out why together. The theory arrives exactly when you need it to fix the thing in front of you.</p>
        <p>That is how production teaches. It is slower than a slide deck and it sticks for years.</p>
        <p>I do not believe in certification cramming, in toy clusters that never see traffic, or in courses that are out of date the week they ship. Everything here is updated when the tools change, and you keep access for life.</p>
      </div>
    </div>
  </section>

  <section class="section bg-[var(--bg2)] border-y border-[var(--line)]">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Where I have been</p>
      <ol class="mt-10">
        {history.map(([when, role, where, what], i) => (
          <li class="grid md:grid-cols-[10rem_1fr_1.4fr] gap-x-10 gap-y-2 py-8 border-t border-[var(--line)] last:border-b" data-reveal data-delay={String(i * 0.06)}>
            <span class="mono">{when}</span>
            <div><p class="display text-2xl">{role}</p><p class="text-[var(--muted)]">{where}</p></div>
            <p class="text-[var(--muted)]">{what}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap text-center">
      <p class="eyebrow justify-center" data-reveal>Elsewhere</p>
      <h2 class="display h2 mt-5" data-split>Say <em>hello</em>.</h2>
      <div class="flex gap-3 justify-center flex-wrap mt-10" data-reveal>
        {links.map(([l, h]) => <a href={h} class="btn btn--ghost magnetic">{l}</a>)}
      </div>
    </div>
  </section>
  <script src="../scripts/hero3d.ts"></script>
</Base>

<style>
  .portrait { aspect-ratio: 4 / 5; position: relative; overflow: hidden; background: radial-gradient(80% 60% at 30% 20%, rgba(232, 82, 74, 0.35), transparent 60%), linear-gradient(180deg, var(--bg2), var(--bg)); }
  .portrait__mark { position: absolute; right: -4%; top: -6%; font-size: clamp(9rem, 16vw, 15rem); line-height: 1; color: var(--text); opacity: .06; letter-spacing: -.06em; }
</style>
