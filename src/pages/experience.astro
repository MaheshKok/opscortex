---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/experience.css';

const courseIds = [
  'kubernetes-in-production',
  'terraform-at-scale',
  'cicd-and-gitops',
  'observability-engineering',
];
const allCourses = await getCollection('courses');
const courses = courseIds
  .map((id) => allCourses.find((course) => course.id === id))
  .filter((course): course is (typeof allCourses)[number] => Boolean(course));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Behind the Click · OpsCortex</title>
    <meta name="description" content="A visual prototype for hands-on production engineering courses." />
    <link rel="icon" href="/images/brand/logo-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/images/brand/logo-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        document.documentElement.dataset.theme = localStorage.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      } catch { document.documentElement.dataset.theme = 'dark'; }
    </script>
  </head>
  <body class="experience-page">
    <a class="skip" href="#main">Skip to content</a>
    <header class="experience-nav">
      <div class="wrap experience-nav__in">
        <a href="/" class="brand">
          <img class="brand__logo--light" src="/images/brand/logo-light.png" alt="OpsCortex owl" width="32" height="32" />
          <img class="brand__logo--dark" src="/images/brand/logo-dark.png" alt="OpsCortex owl" width="32" height="32" />
          <span>OpsCortex</span>
        </a>
        <nav aria-label="Primary"><a aria-current="page" href="/experience">Experience</a><a href="/courses">Courses</a></nav>
        <button class="theme" type="button" aria-label="Toggle light or dark theme">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
    </header>

    <main id="main">
      <section class="arrival" data-sc-act="flow" aria-labelledby="arrival-title">
        <div class="arrival__media" data-arrival-media>
          <img src="/images/experience/arrival.jpg" alt="A warm-lit aisle of production engineering infrastructure" width="1600" height="1000" />
          <div class="arrival__scrim"></div>
        </div>
        <div class="wrap arrival__content">
          <p class="eyebrow">Behind the click</p>
          <h1 id="arrival-title" class="display">Production is where <em>theory ends.</em></h1>
          <p>Hands-on courses in Kubernetes, cloud and production engineering.</p>
          <div class="arrival__actions">
            <a class="btn" href="/courses">Explore courses</a>
            <a class="arrival__link" href="#mission">Meet the application</a>
          </div>
        </div>
      </section>

      <section id="mission" class="journey" data-journey-phase="application" data-journey-progress="0" data-sc-act="journey=static" aria-labelledby="journey-title">
        <div class="journey__stage">
          <div class="journey__scene" data-journey-scene aria-hidden="true"><canvas></canvas></div>
          <p class="journey__service mono">Service <span>routes requests to tickets-api</span></p>
          <nav class="journey__rail mono" aria-label="Journey chapters">
            <a href="#application">Application</a>
            <a href="#docker">Docker</a>
            <a href="#kubernetes">Kubernetes</a>
          </nav>
        </div>
        <div class="journey__chapters">
          <section id="application" class="journey__chapter journey__chapter--application" aria-labelledby="journey-title">
            <div class="wrap journey__chapter-in">
              <div class="journey__copy">
                <p class="eyebrow">Application</p>
                <h2 id="journey-title" class="display">Meet the app behind <em>opening night.</em></h2>
                <p class="lead">tickets-api reserves Front row seats for ON-2047. It works locally; the question is how to carry that behavior into production.</p>
                <p class="journey__detail mono">tickets-api · 2 seats · confirmed</p>
                <nav class="journey__fallback-rail mono" aria-label="Journey chapters"><a href="#application">Application</a><a href="#docker">Docker</a><a href="#kubernetes">Kubernetes</a></nav>
              </div>
              <img class="journey__fallback" src="/images/experience/journey-application.jpg" alt="The tickets-api application showing a confirmed opening-night booking" width="1400" height="900" />
            </div>
          </section>
          <section id="docker" class="journey__chapter journey__chapter--docker" aria-labelledby="docker-title">
            <div class="wrap journey__chapter-in">
              <div class="journey__copy">
                <p class="eyebrow">Docker</p>
                <h2 id="docker-title" class="display">Package the app with its <em>dependencies.</em></h2>
                <p class="lead">The shell closes around the same tickets-api application to make one portable image. The ticket does not change; its runtime becomes explicit.</p>
                <p class="journey__detail mono">image · app + dependencies</p>
              </div>
              <img class="journey__fallback" src="/images/experience/journey-docker.jpg" alt="The tickets-api application enclosed as a Docker image" width="1400" height="900" />
            </div>
          </section>
          <section id="kubernetes" class="journey__chapter journey__chapter--kubernetes" aria-labelledby="kubernetes-title">
            <div class="wrap journey__chapter-in">
              <div class="journey__copy">
                <p class="eyebrow">Kubernetes</p>
                <h2 id="kubernetes-title" class="display">Run three identical <em>Pods.</em></h2>
                <p class="lead">Kubernetes runs the same packaged image three times. A Service gives booking traffic one stable route to those replicas.</p>
                <p class="journey__detail mono">Service → 3 Pods → tickets-api image</p>
              </div>
              <img class="journey__fallback" src="/images/experience/journey-kubernetes.jpg" alt="Three tickets-api Pods behind a Kubernetes Service" width="1400" height="900" />
            </div>
          </section>
        </div>
      </section>

      <section class="workload section section--tight" data-sc-act="flow" aria-labelledby="workload-title">
        <div class="wrap workload__heading">
          <div><p class="eyebrow">Prepared simulation</p><h2 id="workload-title" class="display">Keep the booking <em>moving.</em></h2></div>
          <p class="lead">One replica leaves. The desired state notices, starts another, and returns the workload to three ready replicas.</p>
        </div>
        <div class="wrap" data-recovery data-phase="ready">
          <div class="recovery__board" aria-label="Workload status">
            <div class="recovery__edge"><span class="mono">booking</span><span class="recovery__pulse"></span></div>
            <div class="recovery__replicas">
              <article class="replica" data-replica="1"><span class="mono">pod-01</span><strong>Ready</strong><i></i></article>
              <article class="replica" data-replica="2"><span class="mono">pod-02</span><strong>Ready</strong><i></i></article>
              <article class="replica" data-replica="3"><span class="mono">pod-03</span><strong>Ready</strong><i></i></article>
              <article class="replica replica--replacement" data-replacement><span class="mono">pod-04</span><strong>Starting</strong><i></i></article>
            </div>
            <p class="recovery__message" data-recovery-message aria-live="polite">3 replicas ready. Booking remains available.</p>
          </div>
          <div class="recovery__controls" aria-label="Simulation controls">
            <button class="btn" type="button" data-stop>Stop one replica</button>
            <button class="btn btn--ghost" type="button" data-reset>Reset</button>
          </div>
          <noscript><p class="recovery__nojs">Static complete sequence: booking remains available while pod-03 stops, pod-04 starts, and the workload returns to three ready replicas. Enable JavaScript to replay the prepared simulation.</p></noscript>
        </div>
      </section>

      <section class="offer section" data-sc-act="flow" aria-labelledby="offer-title">
        <div class="wrap offer__top"><h2 id="offer-title" class="display">You’ve seen what it does. <em>Now learn how to build it.</em></h2></div>
        <div class="wrap offer__rows">
          {courses.map((course, index) => <a href={`/courses/${course.id}`} class="course-row"><span class="mono">0{index + 1}</span><strong>{course.data.title}</strong><span>{course.data.level}</span><span aria-hidden="true">→</span></a>)}
        </div>
        <div class="wrap offer__footer"><a class="btn" href="/courses">View all courses</a></div>
      </section>
    </main>
    <script src="../scripts/experience.ts"></script>
  </body>
</html>
